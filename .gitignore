models/t5_finetuned/

# Hugging Face cache
~/.cache/huggingface/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# OS
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/

# Results (optional: comment out if you want to commit results)
# results/

# Logs
*.log
